OPENAI_API_KEY=sk-your-key-here
# Optional: override the model used by all debate agents
# DEBATE_MODEL=gpt-4o-mini

# Expert Agents platform — members-only gate (required on production)
EXPERTS_PLATFORM_PASSWORD=
# Optional: separate secret for signed platform cookies (defaults to password)
# EXPERTS_PLATFORM_ACCESS_SECRET=

# Mount path when served under fmsthinktank.org/experts (default /experts)
NEXT_PUBLIC_BASE_PATH=/experts

# Historical Round Table — private passcode gate (required on production)
ROUNDTABLE_PASSCODE=
# Optional: separate secret for signed access cookies (defaults to passcode)
# ROUNDTABLE_ACCESS_SECRET=

# PostgreSQL (Neon). Required for prisma migrate / db push / seed.
# Example: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Optional seed overrides (packages/db/prisma/seed.ts)
# SEED_CLERK_USER_ID=user_dev_seed
# SEED_USER_EMAIL=dev@example.com
